{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/loganriebel/meta-ads-agent/schemas/campaign_draft.schema.json",
  "title": "CampaignDraft",
  "type": "object",
  "required": ["_meta", "campaign", "ad_sets"],
  "properties": {
    "_meta": {
      "type": "object",
      "required": ["slug", "status"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "approved"] },
        "created": { "type": "string" }
      }
    },
    "campaign": {
      "type": "object",
      "required": ["name", "objective"],
      "properties": {
        "name": { "type": "string" },
        "objective": { "type": "string" },
        "status": { "type": "string" },
        "buying_type": { "type": "string" }
      }
    },
    "ad_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "ads"],
        "properties": {
          "name": { "type": "string" },
          "daily_budget_usd": { "type": "number", "minimum": 0 },
          "targeting": { "type": "object" },
          "ads": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "copy"],
              "properties": {
                "name": { "type": "string" },
                "creative_ref": { "type": "string" },
                "copy": {
                  "type": "object",
                  "required": ["primary_text", "headline"],
                  "properties": {
                    "primary_text": { "type": "string" },
                    "headline": { "type": "string" },
                    "description": { "type": "string" },
                    "cta": { "type": "string" },
                    "url": { "type": "string" }
                  }
                },
                "utm": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "launch_checklist": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

# Local config overrides (optional — template ships meta-ads-config.yaml with placeholders)
# meta-ads-config.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

